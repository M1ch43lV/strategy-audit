ARG BASE_IMAGE=freqtradeorg/freqtrade:2026.7@sha256:742730fbe2f6f1bb69d36357c933df1ab62f5a6102bfd3f71a0bf58b8d61f009
FROM ${BASE_IMAGE}

# The repository is mounted at /audit by the diagnostic runner. Putting the
# versioned Class 1 shim directory on PYTHONPATH activates its sitecustomize in
# the parent and every Freqtrade subprocess.
ENV PYTHONPATH=/audit/repair

# Match the versioned Windows audit stack while executing native Linux wheels
# outside Smart App Control's Windows DLL enforcement boundary.
COPY --chown=ftuser:ftuser requirements-audit-runtime.txt /tmp/
RUN python -m pip install --user --no-cache-dir \
      -r /tmp/requirements-audit-runtime.txt \
    && python -c "import freqtrade,numpy,pandas,scipy,talib; assert freqtrade.__version__ == '2026.7'; assert numpy.__version__ == '2.5.2'; assert pandas.__version__ == '3.0.5'; assert scipy.__version__ == '1.18.1'; assert talib.__version__ == '0.7.1'"

LABEL org.opencontainers.image.title="strategy-audit bias runtime" \
      org.opencontainers.image.description="Pinned Linux runtime for Stage 6 diagnostics"
