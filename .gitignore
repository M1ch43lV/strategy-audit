# Downloaded market data — regenerate with fetch_bulk.py
data/
*.csv
# ...except the ledger itself. It is not market data: it is the published
# record every number in this repository is derived from, and verify_ledger.py
# refuses to run without it. Excluded once by accident — CI would have failed
# with "LEDGER.csv is missing", which is the correct failure for a missing
# ledger and the wrong reason to see it.
!LEDGER.csv

# Same reasoning for the DCA record: it is derived and published, not
# market data. dca.py regenerates it; without it DCA.md would be prose.
!DCA.csv

# And CLAIMS.csv, which freeze_guard.py reads and README links to. It was
# swept up by *.csv and never committed: the link 404'd and every clean
# checkout failed CI, while the working tree passed. See CORRECTIONS.md.
!CLAIMS.csv

# Published, reproducible canonical strategy/run-profile manifest.
!EXECUTION_PROFILES.csv
!PROFILE_CLASS1.json
!PROFILE_BIAS.json
!PROFILE_REPAIRS.json
!PROFILE_SMOKE.json
!REGIME_COVERAGE.csv
!REGIME_ELIGIBILITY.csv
!cluster/CLUSTERS.csv
!results/regime/*.csv

# Downloaded upstream strategy repositories - regenerate from the corpus
# source list. Their nested .git directories and worktrees do not belong to
# this audit repository.
/repos/

# Freqtrade runtime state: generated configs, trained FreqAI models and
# backtest archives. Recreated by setup/run scripts and potentially very large.
/user_data/

# Raw per-strategy harness output. The versioned evidence is rendered into the
# corpus cards / ledger; keep the five tracked Markdown case studies visible.
/results/*.json

# Secrets — never commit. This list is convenience, not a control:
# the control is tools/secret_gate.py, wired as a pre-commit hook.
*.env
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
secrets/
**/secrets/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Runtime logs and process locks
*.log
/fetch.lock
/corpus.lock
